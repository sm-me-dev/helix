test-results/
playwright-report/
playwright/.cache/

# Local tooling caches (keep configs, ignore runtime state)
.serena/cache/
.grok/status
.tanstack/

# Graphify index cache (regenerable via `graphify update .`; report + graph.json stay tracked)
graphify-out/cache/
graphify-out/graph.html
graphify-out/20*/
graphify-out/.graphify_*

# Dev QA screenshots & local artifacts (not for public repo)
screenshots/
artifacts/

# Misc junk
*.tmp
*.temp
*.cache
*.bak
*_old.*
*_backup.*
*_copy.*

# Empty placeholder lock from scaffold — not a real lockfile
.node_modules.lock
