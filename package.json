{
  "name": "@sm-me-dev/helix",
  "version": "0.1.0",
  "description": "An AI coding harness that earns its tokens through bounded context, ephemeral worktrees, and zero-token mechanical gates",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sm-me-dev/helix.git"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "helix": "bin/helix.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:mjs": "node --test 'scripts/**/*.test.mjs' 'cli/**/*.test.mjs' 'evals/**/*.test.mjs'",
    "test:ts": "node --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "gpt-tokenizer": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
