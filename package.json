{
  "name": "@sm-me-dev/helix",
  "version": "0.2.0",
  "description": "Helix v2 AI coding harness and execution engine with progressive disclosure, quarantined project knowledge, multi-model orchestration, and synchronized daemon, terminal, and web clients",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sm-me-dev/helix.git"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "helix": "bin/helix.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=26.4"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "node scripts/build.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:mjs": "node --test 'scripts/**/*.test.mjs' 'cli/**/*.test.mjs' 'evals/**/*.test.mjs'",
    "test:ts": "node --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.32",
    "@ast-grep/napi": "^0.51.1",
    "@opentui/core": "^0.8.2",
    "@opentui/react": "^0.8.2",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^13.0.3",
    "dagre": "^0.8.5",
    "gpt-tokenizer": "^4.1.0",
    "react": "^19.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.1",
    "sqlite-vec": "^0.1.9",
    "toml": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
