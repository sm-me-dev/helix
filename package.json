{
  "name": "helix",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "bin": {
    "helix": "cli/helix.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:mjs": "node --test 'scripts/**/*.test.mjs' 'cli/**/*.test.mjs' 'evals/**/*.test.mjs'",
    "test:ts": "node --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.16.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
